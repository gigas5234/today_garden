# ─────────────────────────────────────────────────────────────────────────
# 오늘밭 — 환경 변수
# 비어 있어도 앱은 mock 데이터로 동작합니다. 키를 채워 넣을수록 실제 데이터로 전환됩니다.
# 모든 변수는 서버에서만 사용됨(클라이언트 노출 X). NEXT_PUBLIC_ 접두어 없음.
# ─────────────────────────────────────────────────────────────────────────


# ──────────────── 1) 기상 데이터 (data.go.kr 통합 서비스키) ────────────────
# 발급: https://www.data.go.kr/  →  로그인 →  '오픈API' 검색
# 아래 3개 API를 같은 일반 인증키 하나로 모두 신청 가능합니다.
#   ① 기상청 단기예보 조회서비스      (필수)  — 시간별/주간 날씨
#   ② 한국환경공단 에어코리아 대기오염정보 (필수)  — PM10/PM2.5
#   ③ 한국천문연구원 출몰시각 정보       (선택)  — 일출/일몰
#
# 발급 후 'Encoding' 키를 그대로 붙여넣으세요(URL 인코딩된 형태).
# 비워두면: KMA·에어코리아·KASI 모두 mock 데이터로 동작.
KMA_SERVICE_KEY=

# 위 키 하나만 있으면 자동으로 air/kasi에도 같은 값을 사용합니다.
# 만약 별도 키를 발급받았다면 아래 두 개로 덮어쓸 수 있습니다.
# AIRKOREA_SERVICE_KEY=
# KASI_SERVICE_KEY=


# ──────────────── 2) 카카오 위치 정보 (역지오코딩) ────────────────
# 발급: https://developers.kakao.com/  →  내 애플리케이션 →  앱 만들기
#       → '플랫폼 > Web' 등록 → 'REST API 키' 복사
# 용도: 위경도 → "양평군 ○○면 ○○리" 한글 주소로 변환 (위치 pill 표기용)
# 비워두면: 위치 pill에 좌표 또는 사전 등록 이름만 표시.
KAKAO_REST_API_KEY=


# ──────────────── 3) AI 상담 (Google Gemini) ────────────────
# 모델: gemini-3.1-flash-lite (사용자 지정)
# 발급: https://aistudio.google.com/app/apikey  →  'Create API Key'
# 비워두면: 챗봇이 키워드 기반 mock 응답으로 동작 (M5 구현 후부터 적용).
GEMINI_API_KEY=


# ──────────────── 4) Supabase (DB · Storage) ────────────────
# 발급:
#   1. https://supabase.com/  →  새 프로젝트 생성
#   2. 좌측 'Project Settings' → 'API' 메뉴
#   3. 'Project URL' → SUPABASE_URL
#   4. 'anon public' 키 → SUPABASE_ANON_KEY
#   5. 'service_role' 키 → SUPABASE_SERVICE_ROLE_KEY (서버 전용·외부 노출 금지)
#
# 그리고 좌측 'SQL Editor' 에서 supabase/migrations/0001_init.sql 의 내용을
# 그대로 실행해 주세요(테이블·Storage 버킷 생성).
#
# 비워두면: 작물·할 일·사진 모두 서버 메모리(in-memory)에 저장됨.
#          개발 서버 재시작 시 데이터 초기화. 개인 시연용으로는 충분합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
